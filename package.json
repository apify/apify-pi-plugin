{
  "name": "apify-pi-plugin",
  "version": "1.0.0",
  "description": "Apify Actor integration for the Pi agent: one apify tool (discover/start/collect) for any Actor in Apify Store",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "pi": {
    "extensions": [
      "."
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest --run",
    "setup:pi": "bash scripts/setup.sh",
    "cleanup:pi": "rm -rf .pi-install"
  },
  "dependencies": {
    "apify-client": "^2.26.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.10.5",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "apify",
    "pi",
    "agent",
    "plugin",
    "web-scraping",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "basic-ftp": "^6.2.6"
  }
}
